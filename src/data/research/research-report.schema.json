{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-report/1.0",
  "title": "Research report",
  "type": "object",
  "required": [
    "schema_version",
    "meta",
    "sections"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "market": {
          "type": "string"
        },
        "instrument_type": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "as_of": {
          "type": "string",
          "format": "date"
        },
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "units": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "prefix": {
                "type": "string"
              },
              "suffix": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      }
    }
  },
  "$defs": {
    "tone": {
      "enum": [
        "positive",
        "negative",
        "neutral",
        "info",
        "warning"
      ]
    },
    "format": {
      "enum": [
        "integer",
        "number",
        "signed",
        "percent",
        "currency",
        "date",
        "text"
      ]
    },
    "section": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "rules",
            "metrics",
            "chart",
            "table",
            "callout",
            "notes",
            "text"
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "rules"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ],
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "text"
                  ],
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    }
                  }
                }
              },
              "params": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "metrics"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ],
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "key",
                    "label",
                    "value"
                  ],
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "value": {
                      "type": [
                        "number",
                        "string",
                        "null"
                      ]
                    },
                    "format": {
                      "$ref": "#/$defs/format"
                    },
                    "decimals": {
                      "type": "integer"
                    },
                    "unit": {
                      "type": "string"
                    },
                    "note": {
                      "type": "string"
                    },
                    "tone": {
                      "$ref": "#/$defs/tone"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "chart"
              }
            }
          },
          "then": {
            "required": [
              "chart"
            ],
            "properties": {
              "chart": {
                "type": "object",
                "required": [
                  "kind",
                  "x",
                  "series"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "line",
                      "bar",
                      "scatter",
                      "area"
                    ]
                  },
                  "x": {
                    "type": "object",
                    "required": [
                      "values"
                    ],
                    "properties": {
                      "label": {
                        "type": "string"
                      },
                      "values": {
                        "type": "array"
                      }
                    }
                  },
                  "y": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string"
                      },
                      "unit": {
                        "type": "string"
                      }
                    }
                  },
                  "series": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "name",
                        "values"
                      ],
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "values": {
                          "type": "array",
                          "items": {
                            "type": [
                              "number",
                              "null"
                            ]
                          }
                        },
                        "style": {
                          "enum": [
                            "primary",
                            "comparison",
                            "muted"
                          ]
                        },
                        "tone_by_sign": {
                          "type": "boolean"
                        },
                        "point_tone": {
                          "type": "array",
                          "items": {
                            "$ref": "#/$defs/tone"
                          }
                        },
                        "point_tone_labels": {
                          "type": "object",
                          "description": "Legend text for each tone used in point_tone, e.g. {\"positive\": \"Win\", \"negative\": \"Stopped\"}",
                          "propertyNames": {
                            "$ref": "#/$defs/tone"
                          },
                          "additionalProperties": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "table"
              }
            }
          },
          "then": {
            "required": [
              "columns",
              "rows"
            ],
            "properties": {
              "group_by": {
                "type": "string"
              },
              "default_sort": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "dir": {
                    "enum": [
                      "asc",
                      "desc"
                    ]
                  }
                }
              },
              "columns": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "key",
                    "label",
                    "type"
                  ],
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "type": {
                      "enum": [
                        "string",
                        "number",
                        "date",
                        "badge"
                      ]
                    },
                    "format": {
                      "$ref": "#/$defs/format"
                    },
                    "unit": {
                      "type": "string"
                    },
                    "hidden": {
                      "type": "boolean"
                    },
                    "tone_by_sign": {
                      "type": "boolean"
                    },
                    "options": {
                      "type": "object",
                      "additionalProperties": {
                        "$ref": "#/$defs/tone"
                      }
                    }
                  }
                }
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "details": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "callout"
              }
            }
          },
          "then": {
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "tone": {
                "$ref": "#/$defs/tone"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "notes"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ],
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            }
          },
          "then": {
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  }
}
