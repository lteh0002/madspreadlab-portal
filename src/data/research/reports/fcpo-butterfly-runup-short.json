  "sections": [
    {
      "id": "rules",
      "type": "rules",
      "title": "Strategy rules",
      "items": [
        {
          "label": "Which fly",
          "text": "The next 1-month butterfly to expire, traded only in the month before its contract month."
        },
        {
          "label": "Check day",
          "text": "Close on the 1st trading day of that month."
        },
        {
          "label": "Signal",
          "text": "Short if that close is above the close 40 trading days earlier. Otherwise no trade."
        },
        {
          "label": "Stop",
          "text": "Resting buy-stop 30 pts above entry."
        },
        {
          "label": "Exit",
          "text": "Close on the last trading day of the month. Short only, never long."
        }
      ],
      "params": {
        "lookback_trading_days": 40,
        "stop_pts": 30,
        "direction": "short",
        "point_value_myr": 25
      }
    },
